# Entorno: development | production | test
NODE_ENV=development
PORT=3000

# Debe coincidir con las credenciales de docker-compose.yml
DATABASE_URL=postgresql://auditsys_user:CAMBIAR_PASSWORD@localhost:5432/auditsys_db

# Secreto para firmar JWT (HS256). Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h

# Clave HMAC-SHA256 de la organización para la Hash Chain y la firma de informes.
# ¡NO CAMBIAR una vez haya registros en bitacora_hash_chain! Invalidaría toda la cadena.
ORG_HMAC_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Factor de coste de bcrypt (10-14)
BCRYPT_ROUNDS=12

# Usuarios por defecto: solo desarrollo / QA (se ignora en producción).
# Las contraseñas deben cumplir la política: >=12 caracteres, mayúscula, minúscula, dígito y símbolo.
SEED_DEFAULT_USERS=true
SEED_ADMIN_EMAIL=admin@auditsys.co
SEED_ADMIN_PASSWORD="CAMBIAR.Admin#2026"
SEED_AUDITOR_EMAIL=auditor@auditsys.co
SEED_AUDITOR_PASSWORD="CAMBIAR.Auditor#2026"

# URL base que usa npm run test:qa
QA_API_URL=http://localhost:3000/api
